# Sao chép file này thành .env rồi điền giá trị thật.

# Chuỗi kết nối PostgreSQL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/taxua_trip?schema=public"

# Khóa bí mật ký phiên đăng nhập admin (chuỗi ngẫu nhiên đủ dài).
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-dai"

# Tài khoản admin khởi tạo khi chạy seed.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="doi-mat-khau-manh"

# URL công khai của site.
NEXT_PUBLIC_SITE_URL="https://taxuatrip.vn"

# Thư mục lưu ảnh upload.
UPLOAD_DIR="public/uploads"
