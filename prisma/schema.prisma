// Tà Xùa Trip — Prisma schema
// Thiết kế vừa đủ: bài đăng dịch vụ + giá & tình trạng còn chỗ theo ngày + yêu cầu đặt.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================ ENUMS ============================

/// Danh mục dịch vụ (cố định, dùng enum để chống dữ liệu sai).
enum ServiceCategory {
  CABIN // Xe cabin
  HOMESTAY // Homestay
  BUNGALOW // Bungalow
  MOTORBIKE // Thuê xe máy
  XEOM // Xe ôm
  TAXI // Taxi
  COMBO // Combo du lịch
}

/// Tình trạng còn chỗ — phân biệt rõ, không mặc định "còn chỗ" khi chưa có dữ liệu.
enum AvailabilityStatus {
  AVAILABLE // Còn chỗ
  LIMITED // Còn ít chỗ
  SOLD_OUT // Hết chỗ
  NOT_UPDATED // Chưa cập nhật
  PENDING_CONFIRM // Chờ xác nhận
}

/// Chiều của lộ trình xe cabin.
enum CabinDirection {
  OUTBOUND // Chiều đi
  RETURN // Chiều về
}

/// Loại vé xe cabin.
enum CabinTicketType {
  ROUND_TRIP // Khứ hồi (2 chiều)
  OUTBOUND // Chiều đi
  RETURN // Chiều về
}

/// Trạng thái từng phòng riêng theo ngày (quản lý dạng lưới như bảng Excel).
enum RoomStatus {
  AVAILABLE // Trống
  BOOKED // Đã đặt
  PENDING // Chờ
  CLOSED // Đóng (không bán)
}

/// Trạng thái yêu cầu đặt dịch vụ.
enum BookingStatus {
  NEW // Mới
  CONTACTING // Đang liên hệ
  CONFIRMED // Đã xác nhận
  COMPLETED // Đã hoàn thành
  CANCELLED // Đã hủy
}

// ============================ MODELS ============================

/// Vai trò tài khoản.
enum UserRole {
  ADMIN // Quản trị toàn hệ thống
  CTV // Cộng tác viên (đặt đơn)
  PROVIDER // Chủ nhà xe / chủ homestay
}

/// Tiến độ thanh toán của khách cho đơn.
enum PaymentStatus {
  UNPAID // Chưa thu
  DEPOSITED // Đã cọc (thu một phần)
  PAID // Đã thanh toán đủ
}

/// Chính sách bán cuối tuần của homestay: một số nơi chỉ nhận đặt NGUYÊN CỤM
/// các đêm cuối tuần, không bán lẻ (vd không bán riêng đêm T7).
enum WeekendPolicy {
  NONE // Bán lẻ từng đêm bình thường
  FRI_SAT // Cụm T6 + T7 (phải đặt cả 2 đêm)
  SAT_SUN // Cụm T7 + CN (phải đặt cả 2 đêm)
  FRI_SUN // Cụm T6 + T7 + CN (phải đặt cả 3 đêm)
  SAT_PAIRED // T7 không bán lẻ: phải kèm T6 hoặc CN (T6+T7, T7+CN hoặc cả 3 đêm)
}

/// Tài khoản (Admin / CTV / Chủ dịch vụ).
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  phone        String?
  role         UserRole @default(ADMIN)
  active       Boolean  @default(true)
  providerId   String? // với CTV: thuộc chủ cơ sở nào
  commissionPerOrder Decimal? @db.Decimal(12, 0) // với CTV: hoa hồng cố định/đơn (mặc định)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider      AdminUser?       @relation("ProviderCtv", fields: [providerId], references: [id], onDelete: SetNull)
  ctvs          AdminUser[]      @relation("ProviderCtv")
  ownedServices Service[]        @relation("ServiceOwner")
  ctvBookings   BookingRequest[] @relation("BookingCtv")

  @@index([providerId])
}

/// Bài đăng dịch vụ — thực thể trung tâm.
model Service {
  id          String          @id @default(cuid())
  slug        String          @unique
  category    ServiceCategory
  title       String
  summary     String // mô tả ngắn
  description String // mô tả chi tiết
  area        String? // khu vực hoặc tuyến đường
  distanceKm  Float? // cách trung tâm Tà Xùa bao nhiêu km (0 = ngay trung tâm) — lọc/sắp xếp "gần trung tâm"
  mapUrl      String? // link Google Maps (chia sẻ hoặc nhúng) để hiển thị bản đồ
  policy      String? // chính sách homestay (nhận/trả phòng, huỷ, nội quy...) hiển thị cho khách
  basePrice   Decimal?        @db.Decimal(12, 0) // giá tham khảo (null = liên hệ)
  originalPrice Decimal?      @db.Decimal(12, 0) // giá gốc hiển thị gạch ngang (null = không khuyến mãi)
  priceUnit   String? // đơn vị giá: "/đêm", "/ngày", "/vé", "/chuyến"...
  contactName String?
  contactPhone String?
  contactZalo String?
  featured    Boolean         @default(false)
  // Thứ tự ưu tiên khi tìm kiếm (combo/homestay): trong nhóm "Nổi bật", số càng LỚN càng lên trước.
  priorityOrder Int           @default(0)
  published   Boolean         @default(true)
  easyRoad    Boolean         @default(false) // đường dễ đi (dùng cho combo homestay)
  pool        Boolean         @default(false) // có hồ bơi (tiện ích homestay)
  contactOnly Boolean         @default(false) // không quản lý lịch trên web: luôn hiện "còn chỗ" khi tìm kiếm, khách nhắn tin để nhận thông tin (không đặt trực tiếp)
  // NGÀY HẾT PHÒNG (yyyy-mm-dd, mỗi ngày = 1 đêm) cho homestay "không quản lý lịch" (contactOnly):
  // kỳ tìm kiếm trùng đêm nào trong danh sách thì home bị ẩn khỏi kết quả tìm homestay.
  soldOutDates String[] @default([])
  // Đồng bộ lịch phòng từ Google Sheet công khai (mỗi homestay 1 link; bố trí cột tự dò).
  sheetUrl      String? // link Google Sheet (bất kỳ dạng /edit, /htmlview, #gid=...) chứa lịch phòng
  sheetSyncedAt DateTime? // lần đồng bộ gần nhất
  sheetSyncResult String? // kết quả lần đồng bộ ("12 phòng · 30 ngày" | "Lỗi: ...")
  ownerId     String? // chủ dịch vụ (nhà xe / homestay)
  owner       AdminUser?      @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ctvCommission Decimal?      @db.Decimal(12, 0) // hoa hồng CTV/đơn — ghi đè mức mặc định của CTV cho dịch vụ này
  // Chiết khấu mặc định cho CẢ homestay (đ/phòng/đêm): dùng khi phòng (và ngày) không
  // khai riêng chiết khấu. null = không có fallback (chỉ dùng mức khai ở từng phòng).
  roomCommission Decimal?     @db.Decimal(12, 0)
  busCommission  Decimal?     @db.Decimal(12, 0) // nhà xe cabin: chiết khấu cho sàn (đ / khách / chiều)
  weekendPolicy WeekendPolicy @default(NONE) // chính sách bán cuối tuần theo cụm (homestay)
  // Homestay: trẻ DƯỚI số tuổi này được MIỄN PHÍ (không tính người, không phụ thu);
  // từ tuổi này tính như 1 người (vào sức chứa + phụ thu người thêm nếu vượt chuẩn).
  childFreeUnderAge Int        @default(6)
  // Phụ thu CHUNG cho cả homestay (đ): mỗi người vượt sức chứa chuẩn/đêm; check-in sớm;
  // check-out muộn. null = không có. (Trước đây để ở từng phòng → gộp về cấp home.)
  extraPersonFee  Decimal? @db.Decimal(12, 0)
  earlyCheckinFee Decimal? @db.Decimal(12, 0)
  lateCheckoutFee Decimal? @db.Decimal(12, 0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  images         ServiceImage[]
  sheetSyncLogs  SheetSyncLog[]
  roomTypes      RoomType[]
  cabinTrips     CabinTrip[]
  rentalVehicles RentalVehicle[]
  transport      TransportInfo?
  bookings       BookingRequest[]
  cabinPriceRows CabinPriceRow[]
  cabinRoutes    CabinRoute[]
  reviews        Review[]

  @@index([category, published])
  @@index([featured])
}

/// Nhật ký đồng bộ lịch Google Sheet của homestay. Ghi khi: chạy tay (luôn),
/// cron có thay đổi, hoặc lỗi (cron lỗi lặp lại giống hệt thì không ghi thêm).
model SheetSyncLog {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  ok        Boolean
  source    String   @default("MANUAL") // "MANUAL" (nút trong admin) | "CRON" (tự động định kỳ)
  summary   String // "15 tab · 17 phòng · 457 ngày đã đồng bộ" | "Lỗi: ..."
  changes   Int      @default(0) // số ô (phòng × ngày) đổi trạng thái trong lần chạy này
  createdAt DateTime @default(now())

  @@index([serviceId, createdAt])
  @@index([createdAt])
}

/// Ảnh của bài đăng (upload nhiều ảnh).
model ServiceImage {
  id        String   @id @default(cuid())
  serviceId String
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([serviceId])
}

/// Loại phòng cho homestay / bungalow.
model RoomType {
  id           String   @id @default(cuid())
  serviceId    String
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int      @default(2)
  weekdayPrice Decimal  @db.Decimal(12, 0) // giá ngày thường (mặc định cho T2–T6)
  weekendPrice Decimal  @db.Decimal(12, 0) // giá cuối tuần (mặc định cho T7, CN)
  holidayPrice Decimal? @db.Decimal(12, 0) // giá ngày lễ (tùy chọn)
  // Giá riêng theo từng thứ trong tuần (tùy chọn). null = dùng weekday/weekend.
  priceMon     Decimal? @db.Decimal(12, 0) // Thứ 2
  priceTue     Decimal? @db.Decimal(12, 0) // Thứ 3
  priceWed     Decimal? @db.Decimal(12, 0) // Thứ 4
  priceThu     Decimal? @db.Decimal(12, 0) // Thứ 5
  priceFri     Decimal? @db.Decimal(12, 0) // Thứ 6
  priceSat     Decimal? @db.Decimal(12, 0) // Thứ 7
  priceSun     Decimal? @db.Decimal(12, 0) // Chủ nhật
  totalRooms   Int      @default(1)
  imageUrl     String? // ảnh bìa (tương thích cũ; ưu tiên images[])
  // Tiện ích (dùng để lọc combo)
  hasBathtub   Boolean  @default(false) // bồn tắm
  cloudView    Boolean  @default(false) // view săn mây
  breakfast    Boolean  @default(false) // ăn sáng
  airCon       Boolean  @default(false) // điều hòa
  heating      Boolean  @default(false) // đêm sưởi / máy sưởi
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  availabilities RoomAvailability[]
  images         RoomTypeImage[]
  rooms          Room[]

  @@index([serviceId])
}

/// Phòng riêng lẻ (có tên) thuộc một hạng phòng. VD: Rustic 1, Samu 3...
model Room {
  id          String          @id @default(cuid())
  roomTypeId  String
  roomType    RoomType        @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name        String
  amenities   String? // tiện ích, phân tách bằng dấu phẩy (Wifi, Nóng lạnh, Ban công...)
  description String?
  // Giá & sức chứa ở cấp phòng con (nguồn chính). listPrice = giá niêm yết (giá thường);
  // salePrice = giá chiết khấu (giá bán thực, null = không giảm). Giá theo thứ ghi đè.
  capacity    Int             @default(2)
  // Sức chứa tối đa (nhận thêm người kèm phụ thu). null = bằng capacity (không nhận thêm).
  maxCapacity Int?
  // Tên khác của phòng trong Google Sheet lịch (cách nhau dấu phẩy/chấm phẩy) — sheet-sync
  // khớp thêm theo các tên này (vd chủ nhà ghi "Vip Xoay 1" tháng này, "Vip360 1" tháng khác).
  sheetAlias  String?
  // Phòng nổi bật: hiện lên ĐẦU trang tìm homestay (trạng thái sắp xếp mặc định).
  featured    Boolean @default(false)
  // Phòng KHÔNG áp khuyến mãi combo (−25k/khách): tick ⇒ đặt combo có phòng này không được giảm.
  noComboDiscount Boolean @default(false)
  // (Phụ thu người thêm / check-in sớm / check-out muộn đã chuyển lên cấp HOMESTAY — xem Service.)
  listPrice   Decimal         @default(0) @db.Decimal(12, 0)
  salePrice   Decimal?        @db.Decimal(12, 0)
  priceMon    Decimal?        @db.Decimal(12, 0)
  priceTue    Decimal?        @db.Decimal(12, 0)
  priceWed    Decimal?        @db.Decimal(12, 0)
  priceThu    Decimal?        @db.Decimal(12, 0)
  priceFri    Decimal?        @db.Decimal(12, 0)
  priceSat    Decimal?        @db.Decimal(12, 0)
  priceSun    Decimal?        @db.Decimal(12, 0)
  // Giá gạch (niêm yết) theo thứ — để gạch ngang cạnh giá-theo-thứ. null = dùng
  // giá niêm yết chung (listPrice) khi có giảm, hoặc không gạch.
  listPriceMon Decimal? @db.Decimal(12, 0)
  listPriceTue Decimal? @db.Decimal(12, 0)
  listPriceWed Decimal? @db.Decimal(12, 0)
  listPriceThu Decimal? @db.Decimal(12, 0)
  listPriceFri Decimal? @db.Decimal(12, 0)
  listPriceSat Decimal? @db.Decimal(12, 0)
  listPriceSun Decimal? @db.Decimal(12, 0)
  // Chiết khấu CTV cho phòng này (đ / phòng / đêm). commission = mức cơ bản;
  // commissionMon..Sun ghi đè theo thứ. null = không chiết khấu (0).
  commission    Decimal? @db.Decimal(12, 0)
  commissionMon Decimal? @db.Decimal(12, 0)
  commissionTue Decimal? @db.Decimal(12, 0)
  commissionWed Decimal? @db.Decimal(12, 0)
  commissionThu Decimal? @db.Decimal(12, 0)
  commissionFri Decimal? @db.Decimal(12, 0)
  commissionSat Decimal? @db.Decimal(12, 0)
  commissionSun Decimal? @db.Decimal(12, 0)
  sortOrder   Int             @default(0)
  icalToken   String?         @unique // token bí mật cho link xuất lịch iCal (OTA)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  dayStatuses RoomDayStatus[]
  images      RoomImage[]
  icalSources RoomIcalSource[]

  @@index([roomTypeId])
}

/// Lịch iCal của phòng trên một OTA (Booking/Agoda/Airbnb…) để nhập ngày bận về.
model RoomIcalSource {
  id           String    @id @default(cuid())
  roomId       String
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  label        String // "Booking.com" | "Agoda" | "Airbnb"…
  url          String // link .ics OTA cung cấp
  lastSyncedAt DateTime?
  lastResult   String? // "12 ngày bận" | "Lỗi: ..."
  createdAt    DateTime  @default(now())

  @@index([roomId])
}

/// Ảnh của một phòng riêng lẻ.
model RoomImage {
  id        String   @id @default(cuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isCover   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([roomId])
}

/// Trạng thái của một phòng riêng trong một ngày (ô trong lưới).
model RoomDayStatus {
  id        String     @id @default(cuid())
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  date      DateTime   @db.Date
  status    RoomStatus @default(AVAILABLE)
  bookingId String? // đơn đang chiếm phòng (để tự trả khi huỷ)
  note      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([roomId, date])
  @@index([date])
}

/// Nhiều ảnh / video cho mỗi hạng phòng.
model RoomTypeImage {
  id         String   @id @default(cuid())
  roomTypeId String
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  type       String   @default("image") // "image" | "video"
  alt        String?
  sortOrder  Int      @default(0)
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([roomTypeId])
}

/// Lịch theo ngày của loại phòng: số phòng trống + giá riêng + tình trạng.
model RoomAvailability {
  id            String             @id @default(cuid())
  roomTypeId    String
  roomType      RoomType           @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date          DateTime           @db.Date
  availableRooms Int               @default(0)
  priceOverride Decimal?           @db.Decimal(12, 0)
  status        AvailabilityStatus @default(NOT_UPDATED)
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([roomTypeId, date]) // chống trùng ngày
  @@index([date])
}

/// Chuyến xe cabin — mỗi chuyến gắn với một ngày khởi hành cụ thể.
model CabinTrip {
  id            String             @id @default(cuid())
  serviceId     String
  service       Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  operatorName  String // nhà xe
  route         String // tuyến đường
  direction     CabinDirection     @default(OUTBOUND) // chiều đi / chiều về
  departureDate DateTime           @db.Date
  departureTime String // giờ khởi hành "06:30"
  pickupPoint   String
  dropoffPoint  String
  // Cabin đơn: price = giá, seatsAvailable = số chỗ còn
  price         Decimal            @db.Decimal(12, 0)
  seatsTotal    Int                @default(0)
  seatsAvailable Int               @default(0)
  // Cabin đôi (tuỳ chọn): null/0 = không bán đôi
  priceDouble          Decimal?    @db.Decimal(12, 0)
  seatsDoubleTotal     Int         @default(0)
  seatsDoubleAvailable Int         @default(0)
  status        AvailabilityStatus @default(AVAILABLE)
  note          String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([serviceId, departureDate, direction])
  @@index([departureDate])
}

/// Loại xe máy cho thuê.
model RentalVehicle {
  id          String   @id @default(cuid())
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  vehicleType String // loại xe (Honda Wave, Vision...)
  pricePerDay Decimal  @db.Decimal(12, 0)
  totalUnits  Int      @default(1)
  deliveryFee Decimal? @db.Decimal(12, 0) // phí giao nhận
  imageUrl    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  availabilities RentalAvailability[]

  @@index([serviceId])
}

/// Lịch theo ngày của xe máy: số xe khả dụng + giá riêng + tình trạng.
model RentalAvailability {
  id              String             @id @default(cuid())
  rentalVehicleId String
  rentalVehicle   RentalVehicle      @relation(fields: [rentalVehicleId], references: [id], onDelete: Cascade)
  date            DateTime           @db.Date
  availableUnits  Int                @default(0)
  priceOverride   Decimal?           @db.Decimal(12, 0)
  status          AvailabilityStatus @default(NOT_UPDATED)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([rentalVehicleId, date])
  @@index([date])
}

/// Thông tin xe ôm / taxi (1-1 với Service). Giá có thể null = "Liên hệ xác nhận giá".
model TransportInfo {
  id         String   @id @default(cuid())
  serviceId  String   @unique
  service    Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  fromPoint  String // điểm đón
  toArea     String // điểm đến hoặc khu vực phục vụ
  vehicleType String?
  fixedPrice Decimal? @db.Decimal(12, 0) // null = chưa có giá -> liên hệ xác nhận
  priceNote  String?
  // Thông tin bác tài (xe ôm / taxi). Avatar dùng ảnh dịch vụ (ảnh đầu tiên).
  driverName      String? // tên bác tài
  driverPhone     String? // SĐT bác tài
  driverBirthYear Int? // năm sinh
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Yêu cầu đặt dịch vụ (khách không cần đăng ký tài khoản).
model BookingRequest {
  id              String        @id @default(cuid())
  code            String        @unique // mã yêu cầu VD: TX-A1B2C3
  category        ServiceCategory
  serviceId       String?
  service         Service?      @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceTitle    String // snapshot tên dịch vụ tại thời điểm đặt

  customerName    String
  phone           String
  customerFacebook String? // link Facebook của khách (admin nhập khi đặt hộ / chăm sóc)
  note            String?

  useDate         DateTime      @db.Date // ngày đi / nhận phòng / nhận xe
  endDate         DateTime?     @db.Date // ngày trả (lưu trú / thuê xe)
  nights          Int? // số đêm (nếu lưu trú)
  quantity        Int           @default(1) // số người / phòng / xe / vé
  // Homestay/combo: tách người lớn & trẻ em (tuổi) để tính phụ thu + hiện bill chính xác.
  adults          Int? // số người lớn (null = đơn cũ chưa tách)
  childrenAges    Int[]         @default([]) // tuổi từng trẻ đi kèm (trẻ dưới ngưỡng miễn phí)

  // Tham chiếu tùy loại dịch vụ (ghi nhận lựa chọn cụ thể của khách).
  roomTypeId      String?
  roomId          String? // phòng cụ thể được đặt (homestay)
  roomIds         String[] @default([]) // combo ghép NHIỀU phòng: toàn bộ phòng cần giữ (roomId = phòng đầu)
  cabinTripId     String? // chuyến đi (cabin)
  cabinReturnTripId String? // chuyến về (cabin khứ hồi)
  seatsSingle     Int? // số vé cabin đơn (mỗi chiều)
  seatsDouble     Int? // số vé cabin đôi (mỗi chiều)
  /// Cách nằm xe cabin THEO NGƯỜI (đơn cabin & combo): số khách nằm ghép (cabin đôi, 1 vé/người)
  /// và nằm riêng (cabin đơn, bao buồng = 2 vé/người). null = đơn cũ/đơn tạo hộ chưa ghi.
  cabinShared     Int?
  cabinSolo       Int?
  rentalVehicleId String?
  selectionLabel  String? // mô tả lựa chọn (loại phòng/chuyến/xe) dạng text

  referencePrice  Decimal?      @db.Decimal(12, 0) // giá tham khảo khi gửi (combo: TỔNG khách trả)
  // Đơn COMBO: tách tiền từng bên — bill của bên nào chỉ hiển thị phần bên đó.
  roomAmount      Decimal?      @db.Decimal(12, 0) // phần tiền phòng (về homestay)
  busAmount       Decimal?      @db.Decimal(12, 0) // phần tiền vé khứ hồi (về nhà xe)
  // Phụ thu admin thêm sau khi đặt: [{ id, label, amount, side? }] (side: "room" | "bus" — chỉ combo).
  // referencePrice (và roomAmount/busAmount của combo) ĐÃ GỒM phụ thu: thêm/xoá phụ thu cộng/trừ thẳng vào đó.
  surcharges      Json          @default("[]")
  needsConfirmation Boolean     @default(true) // tình trạng cần admin xác nhận lại
  inventoryApplied Boolean      @default(false) // đã trừ tồn (vé/phòng/xe) hay chưa

  // Cộng tác viên & thanh toán
  ctvId         String? // CTV đã đặt đơn này
  ctv           AdminUser?    @relation("BookingCtv", fields: [ctvId], references: [id], onDelete: SetNull)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  amountCollected Decimal?    @db.Decimal(12, 0) // tổng tiền đã thu của khách (cọc + thanh toán)
  // Hoa hồng CTV (snapshot lúc đặt = Service.ctvCommission ?? CTV.commissionPerOrder ?? 0).
  commissionAmount Decimal?   @db.Decimal(12, 0)
  // Chiết khấu từng căn (snapshot lúc đặt): tổng chiết-khấu-theo-phòng × số đêm của ĐƠN.
  // Tiền chủ dịch vụ thực nhận = (tiền phòng bán ra) − roomCommission. Lưu cho MỌI đơn
  // homestay/combo (kể cả khách tự đặt), không chỉ đơn có CTV.
  roomCommission   Decimal?   @db.Decimal(12, 0)
  // Chiết khấu NHÀ XE cho sàn (snapshot lúc đặt) = Service.busCommission × số khách × số chiều.
  busCommission    Decimal?   @db.Decimal(12, 0)
  commissionPaid   Boolean    @default(false) // đã trả hoa hồng cho CTV chưa
  commissionPaidAt DateTime?

  status          BookingStatus @default(NEW)
  adminNote       String?
  cancelReason    String? // lý do huỷ (để thống kê)
  heldRoom        Boolean       @default(false) // nhà cung cấp phòng/dịch vụ đã xác nhận giữ chỗ
  heldBus         Boolean       @default(false) // nhà xe đã xác nhận giữ chỗ (cabin / combo)
  // Nguồn gửi đơn (chống spam): IP khách (X-Forwarded-For do Caddy đặt) + trình duyệt.
  clientIp        String?
  clientUa        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  logs BookingLog[]

  @@index([clientIp])
  @@index([status])
  @@index([createdAt])
  @@index([serviceId])
  @@index([ctvId])
  @@index([paymentStatus])
}

/// Nhật ký xử lý một đơn đặt: đổi trạng thái, thu tiền, ghi chú nội bộ…
model BookingLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   BookingRequest @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind      String // STATUS | PAYMENT | NOTE | SUPPLIER | SYSTEM
  title     String
  body      String?
  by        String? // tên người thao tác
  createdAt DateTime @default(now())

  @@index([bookingId, createdAt])
}

/// Bài viết kinh nghiệm du lịch Tà Xùa.
model Article {
  id         String   @id @default(cuid())
  slug       String   @unique
  title      String
  excerpt    String?
  content    String // markdown / html đơn giản
  coverImage String?
  topic      String? // chủ đề (key trong ARTICLE_TOPICS): diem-den, lich-trinh, di-chuyen, an-uong, cam-nang
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([published])
}

/// Địa điểm ăn uống (nhà hàng / cafe) hiển thị ở trang /nha-hang và /cafe.
model Place {
  id         String   @id @default(cuid())
  kind       String // "RESTAURANT" | "CAFE" | "CHECKIN" (điểm check-in, hiện ở /lich-trinh)
  slug       String?  @unique // đường dẫn trang chi tiết (/nha-hang/<slug>)
  name       String
  area       String // khu vực (Trung tâm, Đỉnh Gió, Khe Cải...)
  address    String? // địa chỉ chi tiết (nếu có)
  phone      String? // SĐT quán (nếu có)
  zalo       String? // Zalo quán (nếu khác SĐT)
  price      String? // "Từ 40.000đ"...
  hours      String? // "6:00–19:00"
  hoursWeekend String? // giờ mở sớm cuối tuần (VD "05:30")
  booking    String? // nhận đặt bàn: "no" | "call" | "group"
  tags       String? // đặc điểm, phân tách bằng dấu phẩy
  desc       String? // mô tả ngắn (tự biên soạn)
  tip        String? // mẹo ngắn cho khách (hiện ở thẻ trên trang /lich-trinh)
  content    String? // mô tả chi tiết (markdown) cho trang chi tiết
  coverImage String? // ảnh bìa
  images     String? // các ảnh khác, phân tách bằng "|"
  mapUrl     String? // link Google Maps
  mapX       Float? // vị trí trên bản đồ hoạt hình /ban-do (0–100, tương đối; null = theo mặc định của slug)
  mapY       Float?
  sortOrder  Int      @default(0)
  published  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reviews PlaceReview[]

  @@index([kind, published])
}

/// Đánh giá của khách cho một quán (duyệt rồi mới hiện).
model PlaceReview {
  id        String   @id @default(cuid())
  placeId   String
  place     Place    @relation(fields: [placeId], references: [id], onDelete: Cascade)
  name      String // tên người đánh giá
  rating    Int      @default(5) // 1..5
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([placeId, approved])
}

/// Cấu hình site dạng key-value (SĐT, Zalo, địa chỉ, text hero...).
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Bảng giá xe cabin theo chặng (điểm đón → đích). serviceId null = bảng giá chung
/// hiển thị ở trang chủ; serviceId có giá trị = bảng giá riêng của một nhà xe.
model CabinPriceRow {
  id          String   @id @default(cuid())
  serviceId   String?
  service     Service? @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  pickupPoint String // điểm đón (VD: Hà Nội, Hải Dương...)
  destination String          @default("Tà Xùa")
  ticketType  CabinTicketType @default(ROUND_TRIP)
  price       Decimal         @db.Decimal(12, 0)
  note        String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([serviceId])
  @@index([sortOrder])
}

/// Lộ trình xe cabin theo chiều (đi / về) của một nhà xe.
model CabinRoute {
  id         String          @id @default(cuid())
  serviceId  String
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  direction  CabinDirection
  title      String? // tagline hiển thị (VD: "Ngủ một giấc, mở mắt là tới mây.")
  totalTime  String? // tổng thời gian (VD: "~8 tiếng")
  startLabel String? // nhãn mốc khởi hành (VD: "Khởi hành" / "Đón khách")
  startInfo  String? // thông tin khởi hành (VD: "21:00 hằng tối")
  fromPoint  String? // điểm đón
  toPoint    String? // điểm trả
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  stops      CabinRouteStop[]

  @@unique([serviceId, direction])
}

/// Một điểm dừng trong lộ trình (giờ + địa điểm).
model CabinRouteStop {
  id        String     @id @default(cuid())
  routeId   String
  route     CabinRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sortOrder Int        @default(0)
  time      String // VD: "21:00"
  place     String // VD: "Phú Thọ"
  note      String?
  tag       String? // VD: "Nghỉ chân", "Lên xe", "Tới nơi"
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([routeId])
}

// ---- Khách hàng (đăng nhập để đánh giá) ----
model CustomerUser {
  id           String   @id @default(cuid())
  phone        String?  @unique // tài khoản Google/Facebook có thể không có SĐT
  email        String?  @unique // lấy từ Google/Facebook (nếu có)
  passwordHash String? // null nếu đăng nhập bằng Google/Facebook
  name         String
  provider     String   @default("phone") // phone | google | facebook
  providerId   String? // id từ nhà cung cấp OAuth
  createdAt    DateTime @default(now())
  reviews      Review[]
  feedbacks        Feedback[]
  feedbackVotes    FeedbackVote[]
  feedbackComments FeedbackComment[]

  @@index([providerId])
}

enum ReviewStatus {
  APPROVED // hiển thị
  HIDDEN // admin ẩn
}

model Review {
  id         String       @id @default(cuid())
  serviceId  String
  service    Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rating     Int // 1..5 sao
  comment    String?
  status     ReviewStatus @default(APPROVED)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([serviceId, customerId])
  @@index([serviceId])
  @@index([status])
}

/// Bộ đếm truy cập website (1 dòng duy nhất id="main"): tổng lượt xem trang từ trước tới giờ.
model SiteCounter {
  id         String   @id @default("main")
  totalViews Int      @default(0)
  updatedAt  DateTime @updatedAt
}

/// Khách truy cập website (định danh bằng cookie ẩn danh) — đếm khách duy nhất & số người đang online (lastSeen gần đây).
model Visitor {
  id        String   @id // uuid trong cookie tx_vid
  views     Int      @default(1) // số trang đã xem
  firstSeen DateTime @default(now())
  lastSeen  DateTime @default(now())
  // Vị trí THẬT (GPS trình duyệt) — chỉ có khi khách bấm cho phép chia sẻ vị trí.
  lat         Float?
  lng         Float?
  locAccuracy Float? // sai số (mét)
  locAddress  String? // địa chỉ dịch ngược từ toạ độ (OpenStreetMap)
  locAt       DateTime? // lúc ghi nhận vị trí

  @@index([lastSeen])
}

/// Nhật ký từng lượt xem trang (lịch sử truy cập): trang nào, lúc nào, IP, khách
/// đã đăng nhập là ai. Dùng cho trang quản trị "Lượt truy cập".
model PageView {
  id           String   @id @default(cuid())
  visitorId    String // cookie tx_vid (không FK để tránh phụ thuộc thứ tự ghi)
  path         String // đường dẫn trang (VD: /xe-cabin, /homestay/nha-may-si)
  referrer     String? // nguồn vào (document.referrer) — chủ yếu cho lần đầu phiên
  customerId   String? // nếu khách đã đăng nhập
  customerName String? // tên khách lúc xem (tiện hiển thị, không cần join)
  ip           String? // IP (lấy từ x-forwarded-for / x-real-ip)
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([createdAt])
  @@index([customerId])
  @@index([ip])
}

/// Bộ nhớ đệm tra cứu khu vực theo IP (gọi dịch vụ geo-IP 1 lần / IP rồi lưu lại).
model IpGeo {
  ip          String   @id
  country     String? // tên quốc gia (tiếng Việt)
  countryCode String?
  region      String? // tỉnh/thành
  city        String?
  isp         String? // nhà mạng
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// IP bị CHẶN truy cập website công khai + gửi đơn (chống spam). /admin không bị chặn.
model BlockedIp {
  ip        String   @id
  reason    String? // lý do (VD: "spam đơn TX-A1B2C3")
  createdBy String? // username admin đã chặn
  createdAt DateTime @default(now())
}

/// Trình duyệt đã đăng ký nhận Web Push (thông báo đơn mới) của tài khoản quản trị.
model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userId    String? // AdminUser.id đã bật thông báo (không FK — xoá tài khoản không cần dọn)
  role      String? // vai trò lúc đăng ký (ADMIN/PROVIDER/CTV)
  userAgent String?
  createdAt DateTime @default(now())
}

// ---- Góp ý của khách (trang /gop-y) ----
enum FeedbackType {
  IDEA // Đề xuất tính năng
  BUG // Báo lỗi
  SERVICE // Dịch vụ & chuyến đi
  OTHER // Khác
}

enum FeedbackStatus {
  NEW // Mới
  REVIEW // Đang xem xét
  PLAN // Đã lên kế hoạch
  DONE // Đã làm
}

/// Một góp ý công khai: khách đăng nhập mới gửi được; hiện trên bảng công khai
/// để mọi người bình chọn & bình luận. Admin đổi trạng thái + trả lời chính thức.
model Feedback {
  id         String         @id @default(cuid())
  customerId String?
  customer   CustomerUser?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String // tên hiển thị khi gửi (hoặc "Ẩn danh")
  anon       Boolean        @default(false) // ẩn tên trên bảng công khai
  type       FeedbackType   @default(IDEA)
  mood       Int? // chấm trải nghiệm web 1..5 (null = không chấm)
  areas      String[]       @default([]) // chip trang/tính năng liên quan
  message    String
  screenshot String? // url ảnh chụp màn hình (nếu báo lỗi)
  status     FeedbackStatus @default(NEW)
  reply      String? // trả lời chính thức của Tà Xùa Booking
  pinned     Boolean        @default(false) // ghim lên đầu bảng
  hidden     Boolean        @default(false) // admin ẩn khỏi bảng công khai
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  votes    FeedbackVote[]
  comments FeedbackComment[]

  @@index([status])
  @@index([createdAt])
  @@index([hidden])
}

/// Một lượt bình chọn (1 khách / 1 góp ý).
model FeedbackVote {
  id         String       @id @default(cuid())
  feedbackId String
  feedback   Feedback     @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  customerId String
  customer   CustomerUser @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([feedbackId, customerId])
  @@index([feedbackId])
}

/// Bình luận công khai dưới một góp ý.
model FeedbackComment {
  id         String        @id @default(cuid())
  feedbackId String
  feedback   Feedback      @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  customerId String?
  customer   CustomerUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  authorName String
  content    String
  isAdmin    Boolean       @default(false) // bình luận từ Tà Xùa Booking
  createdAt  DateTime      @default(now())

  @@index([feedbackId])
}

/// Nhắc lịch đã gửi (Web Push) cho từng đơn — chống gửi trùng khi cron chạy lặp.
/// kind: CABIN_DEP_AM | CABIN_DEP_PM | CABIN_RET_AM | COMBO_DEP_AM | COMBO_DEP_PM | COMBO_CHECKIN_PAY | COMBO_CHECKOUT
model BookingReminder {
  id        String   @id @default(cuid())
  bookingId String
  kind      String
  sentAt    DateTime @default(now())

  @@unique([bookingId, kind])
  @@index([sentAt])
}
