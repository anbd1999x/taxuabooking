# Caddy — reverse proxy công khai, tự động cấp & gia hạn SSL (Let's Encrypt).
# Biến {$SITE_DOMAIN}, {$SERVER_IP}, {$ACME_EMAIL} lấy từ môi trường (xem docker-compose.prod.yml / .env).

{
	# Email đăng ký ACME (tuỳ chọn — để nhận thông báo hết hạn chứng chỉ).
	email {$ACME_EMAIL}
}

# Domain CHÍNH (canonical cho SEO) — HTTPS tự động, HTTP(80) tự chuyển sang HTTPS.
taxuabooking.com {
	encode zstd gzip
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Các domain phụ 301 về domain chính (tránh trùng lặp nội dung với Google).
# Domain nào chưa trỏ DNS về server thì Caddy bỏ qua, không ảnh hưởng domain đã trỏ.
www.taxuabooking.com, taxuabooking.vn, www.taxuabooking.vn {
	redir https://taxuabooking.com{uri} 301
}

# Truy cập trực tiếp qua IP (HTTP) — tiện test trước khi DNS lan truyền.
http://{$SERVER_IP} {
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
