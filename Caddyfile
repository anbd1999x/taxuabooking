# Caddy — reverse proxy công khai, tự động cấp & gia hạn SSL (Let's Encrypt).
# Biến {$SITE_DOMAIN}, {$SERVER_IP}, {$ACME_EMAIL} lấy từ môi trường (xem docker-compose.prod.yml / .env).

{
	# Email đăng ký ACME (tuỳ chọn — để nhận thông báo hết hạn chứng chỉ).
	email {$ACME_EMAIL}
}

# Các domain phục vụ (cách nhau bằng dấu cách) — HTTPS tự động, HTTP(80) tự
# chuyển hướng sang HTTPS. Mỗi domain Caddy cấp chứng chỉ độc lập; domain nào
# chưa trỏ về server thì bỏ qua, không ảnh hưởng domain đã trỏ đúng.
{$SITE_DOMAINS} {
	encode zstd gzip
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# Truy cập trực tiếp qua IP (HTTP) — tiện test trước khi DNS lan truyền.
http://{$SERVER_IP} {
	reverse_proxy web:80 {
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}
}
